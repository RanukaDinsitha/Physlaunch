<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PhyslaunchSetup</AssemblyName>
    <Product>Physlaunch</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>../assets/physlaunch.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../Setup.hta">
      <LogicalName>Setup.hta</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../app/Physlaunch.hta">
      <LogicalName>Physlaunch.hta</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../app/PhyslaunchRunner.vbs">
      <LogicalName>PhyslaunchRunner.vbs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../assets/physlaunch.ico">
      <LogicalName>assets/physlaunch.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../assets/physlaunch.png">
      <LogicalName>assets/physlaunch.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../LICENSE">
      <LogicalName>LICENSE</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
