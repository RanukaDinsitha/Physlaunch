<!DOCTYPE html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=10">
<title>Physlaunch Setup</title>
<HTA:APPLICATION ID="hta" APPLICATIONNAME="Physlaunch Setup" ICON="assets\physlaunch.ico" BORDER="thin" CAPTION="yes" MAXIMIZEBUTTON="no" SCROLL="no" SELECTION="no" SINGLEINSTANCE="yes" SYSMENU="yes" />
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;800;900&display=swap" rel="stylesheet">

<style>
* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; overflow: hidden; }
body { font-family: 'Nunito', 'Segoe UI', Tahoma, sans-serif; font-size: 14px; color: #c7d5e0; background: linear-gradient(180deg, #1b2838 0%, #171a21 100%); }
button, input { font-family: 'Nunito', 'Segoe UI', Tahoma, sans-serif; }

/* header */
#header { position: absolute; top: 0; left: 28px; right: 28px; height: 68px; padding-top: 16px; }
.logo { position: absolute; left: 0; top: 14px; width: 42px; height: 42px; object-fit: contain; }
.brand { margin-left: 56px; }
.brand h1 { margin: 0; font-size: 25px; line-height: 28px; font-weight: 900; color: #fff; }
.brand h1 span { color: #66c0f4; }
.brand p { margin: 1px 0 0 0; font-size: 12.5px; font-weight: 800; color: #8f98a0; }
#dots { position: absolute; right: 0; top: 24px; }
.dot { display: inline-block; width: 16px; height: 16px; margin-left: 8px; border-radius: 50%; background: #1b2838; border: 2px solid #2a475e; border-bottom-width: 4px; }
.dot.on { border-color: #66c0f4; }
.dot.done { background: #5ba32b; border-color: #3f7a1c; }

/* panes */
#stage { position: absolute; top: 78px; bottom: 24px; left: 28px; right: 28px; }
.pane { background: #1b2838; border: 2px solid #2a475e; border-bottom-width: 6px; border-radius: 22px; }
.view { display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow: hidden; }
#startupFallback { display: block; position: absolute; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; padding: 28px; }
#startupFallback h2 { margin: 0 0 12px; color: #fff; font-size: 20px; }
#startupFallback p { color: #c7d5e0; line-height: 1.6; }
#startupFallback .hint { margin-top: 20px; padding: 14px; border-radius: 12px; background: #171a21; color: #8f98a0; line-height: 1.6; }
#viewWelcome { display: block; }
.ph { height: 54px; padding: 15px 20px 0 18px; font-weight: 900; font-size: 15px; color: #fff; }
.ph .cnt { float: right; font-size: 12.5px; font-weight: 800; color: #8f98a0; margin-top: 2px; }
.num { display: inline-block; width: 24px; height: 24px; line-height: 20px; border-radius: 50%; text-align: center; margin-right: 10px; font-size: 13px; font-weight: 900; color: #0e1b2a; background: #66c0f4; border: 2px solid #3d8fbe; border-bottom-width: 3px; }
.body { padding: 0 22px; }
.intro { margin: 0 0 14px 0; font-size: 13px; font-weight: 800; line-height: 1.55; color: #8f98a0; }
.lab { font-size: 11px; font-weight: 900; letter-spacing: 1.3px; color: #66c0f4; text-transform: uppercase; margin: 14px 0 8px 0; }

/* controls */
.row { position: relative; height: 40px; }
#dirBox { position: absolute; left: 0; right: 92px; height: 38px; padding: 0 16px; border: 2px solid #2a475e; border-bottom-width: 4px; border-radius: 14px; background: #171a21; color: #fff; font-size: 13px; font-weight: 800; outline: none; }
#dirBox:focus { border-color: #66c0f4; }
.mini { background: #223447; border: 2px solid #2a475e; border-bottom-width: 4px; border-radius: 12px; color: #c7d5e0; font-size: 12.5px; font-weight: 900; padding: 1px 14px; cursor: pointer; }
.mini:hover { border-color: #66c0f4; }
.mini:active { transform: translateY(2px); border-bottom-width: 2px; }
.row .mini { position: absolute; right: 0; top: 0; height: 38px; width: 82px; }

.opt { position: relative; padding: 9px 44px 9px 16px; margin-bottom: 9px; border-radius: 16px; background: #223447; border: 2px solid #2a475e; border-bottom-width: 5px; cursor: pointer; transition: transform .12s ease; }
.opt:hover { transform: translateY(-2px); }
.opt.sel { border-color: #66c0f4; border-bottom-color: #3d8fbe; background: #28465f; }
.dt { font-size: 14px; font-weight: 900; color: #fff; }
.ds { font-size: 12px; font-weight: 800; color: #8f98a0; margin-top: 1px; }
.dchk { display: none; position: absolute; right: 14px; top: 16px; width: 22px; height: 22px; line-height: 20px; border-radius: 50%; text-align: center; font-size: 12px; font-weight: 900; color: #0e1b2a; background: #66c0f4; }
.opt.sel .dchk { display: block; }

.big { display: block; width: 100%; height: 52px; margin-top: 14px; border: 0; border-bottom: 6px solid #3f7a1c; border-radius: 16px; background: #5ba32b; color: #fff; font-size: 16px; font-weight: 900; cursor: pointer; }
.big:hover { background: #67b431; }
.big:active { transform: translateY(3px); border-bottom-width: 3px; }
.big.danger { background: #e5594f; border-bottom-color: #a83a32; }
.big.danger:hover { background: #ee6a60; }
.link { display: none; margin: 12px auto 0 auto; }

.warn, .ok, .err { margin-top: 12px; padding: 8px 14px; border-radius: 14px; font-size: 12.5px; font-weight: 800; line-height: 1.5; border: 2px solid; border-bottom-width: 4px; }
.warn { background: rgba(229, 89, 79, .12); border-color: #e5594f; color: #f0a8a0; }
.err { background: rgba(229, 89, 79, .15); border-color: #e5594f; color: #f0a8a0; }
.ok { background: rgba(91, 163, 43, .15); border-color: #3f7a1c; color: #b6e57d; }

/* progress */
.st { position: relative; padding: 11px 14px 11px 46px; margin-bottom: 9px; border-radius: 14px; background: #223447; border: 2px solid #2a475e; border-bottom-width: 4px; font-size: 14px; font-weight: 900; color: #8f98a0; }
.st .sd { position: absolute; left: 12px; top: 8px; width: 24px; height: 24px; line-height: 20px; text-align: center; border-radius: 50%; font-size: 13px; font-weight: 900; color: #0e1b2a; background: #1b2838; border: 2px solid #2a475e; border-bottom-width: 3px; }
.st.run { color: #fff; border-color: #66c0f4; }
.st.run .sd { background: #66c0f4; border-color: #3d8fbe; }
.st.ok { color: #fff; }
.st.ok .sd { background: #5ba32b; border-color: #3f7a1c; }
.st.fail { color: #f0a8a0; border-color: #e5594f; }
.st.fail .sd { background: #e5594f; border-color: #a83a32; }
</style>

<script type="text/javascript">
function urlDecode(s) { try { return decodeURIComponent(s); } catch (e) { return s; } }
function bootSetup() {
    try {
        window.execScript("SetupBoot", "VBScript");
    } catch (e) {
        var fallback = document.getElementById("startupFallback");
        if (fallback) fallback.style.display = "block";
    }
}
function runVB(name) {
    window.execScript(name, "VBScript");
}
</script>
</head>
<body onload="bootSetup()">

<div id="header">
    <img class="logo" src="assets/physlaunch.png" alt="Physlaunch">
    <div class="brand">
        <h1>Phys<span>launch</span> Setup</h1>
        <p>Turn any drive into a game launcher</p>
    </div>
    <div id="dots">
        <span id="dot1" class="dot on"></span>
        <span id="dot2" class="dot"></span>
        <span id="dot3" class="dot"></span>
    </div>
</div>

<div id="stage">

    <div id="startupFallback" class="pane">
        <h2>Setup couldn't start</h2>
        <p>Physlaunch Setup needs Windows' VBScript feature to run. The setup window opened, but its installer script did not start.</p>
        <div class="hint">In Windows 11, open <b>Settings &gt; System &gt; Optional features</b> and install <b>VBScript</b>. Then close this window and run Setup again. If VBScript is already enabled, download a fresh copy of Physlaunch and try again.</div>
    </div>

    <div id="viewWelcome" class="pane view">
        <div class="ph"><span class="cnt" id="verLbl"></span><span class="num">1</span><span id="welcomeTitle">Install Physlaunch</span></div>
        <div class="body">
            <p class="intro">Setup installs the app and the background Runner, adds shortcuts and gives .phys files their icon. It only changes your own user account, so no admin rights are needed.</p>

            <div class="lab">Install location</div>
            <div class="row">
                <input id="dirBox" type="text">
                <button class="mini" onclick="BrowseDir()">Browse...</button>
            </div>

            <div class="lab">Options</div>
            <div id="optDesktop" class="opt sel" onclick="ToggleOpt(1)">
                <div class="dt">Desktop shortcut</div><div class="ds">Add a Physlaunch icon to your desktop</div><div class="dchk">&#10003;</div>
            </div>
            <div id="optRunner" class="opt sel" onclick="ToggleOpt(2)">
                <div class="dt">Start the Runner with Windows</div><div class="ds">Launches games when you plug in a prepared drive</div><div class="dchk">&#10003;</div>
            </div>
            <div id="optAssoc" class="opt sel" onclick="ToggleOpt(3)">
                <div class="dt">Give .phys files the Phys icon</div><div class="ds">Double-clicking one launches its game</div><div class="dchk">&#10003;</div>
            </div>

            <div id="noteBox"></div>
            <button id="btnInstall" class="big" onclick="StartInstall()">Install</button>
            <button id="btnGoUninstall" class="mini link" onclick="ShowConfirm()">Uninstall Physlaunch</button>
        </div>
    </div>

    <div id="viewConfirm" class="pane view">
        <div class="ph"><span class="num">1</span>Uninstall Physlaunch</div>
        <div class="body">
            <p class="intro">This stops the Runner, removes the shortcuts, the .phys file type and all Physlaunch program files. Drives you have already prepared are not touched.</p>
            <button class="big danger" onclick="StartUninstall()">Remove Physlaunch</button>
            <button class="mini" style="display:block;margin:12px auto 0 auto" onclick="window.close()">Cancel</button>
        </div>
    </div>

    <div id="viewProgress" class="pane view">
        <div class="ph"><span class="num">2</span><span id="progTitle">Installing</span></div>
        <div class="body" id="stepList"></div>
    </div>

    <div id="viewDone" class="pane view">
        <div class="ph"><span class="num">3</span><span id="doneTitle">All done</span></div>
        <div class="body">
            <div id="doneMsg"></div>
            <button id="btnOpen" class="big" onclick="OpenApp()">Open Physlaunch</button>
            <button id="btnBack" class="big" style="display:none" onclick="BackToStart()">Back</button>
            <button class="mini" style="display:block;margin:12px auto 0 auto" onclick="window.close()">Close</button>
        </div>
    </div>

</div>

<script type="text/vbscript">
Option Explicit

Const APP_VERSION = "1.0.0"
Const REG_ROOT = "HKCU\Software\Physlaunch"
Const UNINSTALL_KEY = "HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\Physlaunch"
Const PROGID = "Physlaunch.PhysFile"

Dim fso, sh
Dim scriptPath, srcDir, appSrcDir, iconSource, logoSource, cmdArgs
Dim instDir, isUpdate, mode
Dim onDesktop, onRunner, onAssoc
Dim stepKeys, stepState, stepIdx, deletePending

Set fso = CreateObject("Scripting.FileSystemObject")
Set sh = CreateObject("WScript.Shell")
onDesktop = True
onRunner = True
onAssoc = True
deletePending = False


' ---------- small helpers ----------

Function RegGet(key)
    On Error Resume Next
    RegGet = ""
    RegGet = CStr(sh.RegRead(key))
    Err.Clear
End Function

Function HtmlEncode(s)
    s = Replace(s, "&", "&amp;")
    s = Replace(s, "<", "&lt;")
    s = Replace(s, ">", "&gt;")
    HtmlEncode = s
End Function

Function SysPath(name)
    SysPath = sh.ExpandEnvironmentStrings("%SystemRoot%") & "\System32\" & name
End Function

Function QuoteArg(value)
    QuoteArg = Chr(34) & value & Chr(34)
End Function

Function FindPayloadAsset(folder, fileName)
    Dim candidate
    FindPayloadAsset = ""
    For Each candidate In Array( _
        folder & "\assets\" & fileName, _
        folder & "\" & fileName, _
        folder & "\app\assets\" & fileName, _
        folder & "\app\" & fileName)
        If fso.FileExists(candidate) Then
            FindPayloadAsset = candidate
            Exit Function
        End If
    Next
End Function

Sub MakeFolder(path)
    If path = "" Then Exit Sub
    If fso.FolderExists(path) Then Exit Sub
    MakeFolder fso.GetParentFolderName(path)
    fso.CreateFolder path
End Sub

Sub MakeLink(linkPath, target, args, icon, desc)
    Dim lnk
    Set lnk = sh.CreateShortcut(linkPath)
    lnk.TargetPath = target
    lnk.Arguments = args
    lnk.WorkingDirectory = fso.GetParentFolderName(target)
    lnk.IconLocation = icon & ",0"
    lnk.Description = desc
    lnk.Save
End Sub

Sub DeleteFileIfThere(path)
    On Error Resume Next
    If fso.FileExists(path) Then fso.DeleteFile path, True
    Err.Clear
End Sub

Sub RegDeleteTree(key)
    On Error Resume Next
    sh.Run "reg.exe delete """ & key & """ /f", 0, True
    Err.Clear
End Sub

Sub RemoveAssociation
    ' Leave a file association that the user has changed since installation alone.
    If RegGet("HKCU\Software\Classes\.phys\") = PROGID Then
        RegDeleteTree "HKCU\Software\Classes\.phys"
        RegDeleteTree "HKCU\Software\Classes\" & PROGID
    End If
End Sub

' asks Explorer to redraw icons so the .phys icon shows up without a restart
Sub RefreshIcons
    On Error Resume Next
    sh.Run """" & SysPath("ie4uinit.exe") & """ -show", 0, False
    Err.Clear
End Sub

Sub StopRunner
    Dim wmi, p
    On Error Resume Next
    Set wmi = GetObject("winmgmts:\\.\root\cimv2")
    For Each p In wmi.ExecQuery("SELECT * FROM Win32_Process WHERE Name = 'wscript.exe' OR Name = 'cscript.exe'")
        If InStr(LCase(p.CommandLine & ""), "physlaunchrunner.vbs") > 0 Then p.Terminate
    Next
    ' HTAs do not run inside Windows Script Host, so WScript.Sleep is unavailable here.
    sh.Run "cmd.exe /c ping -n 2 127.0.0.1 >nul", 0, True
    Err.Clear
End Sub

Function StartupLink()
    StartupLink = sh.SpecialFolders("Startup") & "\Physlaunch Runner.lnk"
End Function

Function MenuFolder()
    MenuFolder = sh.SpecialFolders("Programs") & "\Physlaunch"
End Function

Function DesktopLink()
    DesktopLink = sh.SpecialFolders("Desktop") & "\Physlaunch.lnk"
End Function


' ---------- startup ----------

Sub ReadCommandLine
    Dim re, m, tok
    scriptPath = ""
    cmdArgs = ""

    Set re = New RegExp
    re.Global = True
    re.Pattern = """([^""]*)""|(\S+)"

    On Error Resume Next
    For Each m In re.Execute(hta.commandLine)
        If m.SubMatches(0) <> "" Then
            tok = m.SubMatches(0)
        Else
            tok = m.SubMatches(1)
        End If

        If scriptPath = "" Then
            If LCase(Right(tok, 4)) = ".hta" Then scriptPath = tok
        Else
            cmdArgs = cmdArgs & " " & LCase(tok)
        End If
    Next
    Err.Clear

    ' fall back to the page address if the command line couldn't be parsed
    If scriptPath = "" Then scriptPath = Replace(Mid(urlDecode(location.pathname), 2), "/", "\")
    srcDir = fso.GetParentFolderName(scriptPath)
End Sub

Sub SetupBoot
    Dim w, h, existing
    w = 680
    h = 700

    On Error Resume Next
    window.resizeTo w, h
    window.moveTo CInt((screen.availWidth - w) / 2), CInt((screen.availHeight - h) / 2)
    Err.Clear
    On Error GoTo 0

    ' Reveal the installer immediately. The fallback stays visible if the
    ' scripting engine is unavailable and this event never runs.
    startupFallback.style.display = "none"
    ShowView "viewWelcome", 1

    ReadCommandLine

    existing = RegGet(REG_ROOT & "\InstallDir")
    isUpdate = (existing <> "" And fso.FileExists(existing & "\app\Physlaunch.hta"))
    If isUpdate Then
        instDir = existing
    Else
        instDir = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Programs\Physlaunch"
    End If

    RenderWelcome

    If InStr(cmdArgs, "/uninstall") > 0 Then
        ' launched from the installed copy, so that folder is the one to remove
        instDir = srcDir
        ShowConfirm
    Else
        ShowView "viewWelcome", 1
    End If
End Sub

Sub Window_OnUnload
    Dim cmd
    If Not deletePending Then Exit Sub

    ' Setup is still running, so let it exit before removing its own file. Delete
    ' only files installed by Physlaunch; non-empty folders are left in place.
    cmd = "cmd.exe /c " & Chr(34) & _
        "ping -n 3 127.0.0.1 >nul & del /f /q " & _
        QuoteArg(instDir & "\app\Physlaunch.hta") & " " & _
        QuoteArg(instDir & "\app\PhyslaunchRunner.vbs") & " " & _
        QuoteArg(instDir & "\app\assets\physlaunch.ico") & " " & _
        QuoteArg(instDir & "\app\assets\physlaunch.png") & " " & _
        QuoteArg(instDir & "\app\physlaunch.ico") & " & rd " & _
        QuoteArg(instDir & "\app\assets") & " & rd " & _
        QuoteArg(instDir & "\app") & " & del /f /q " & _
        QuoteArg(instDir & "\Setup.hta") & " " & _
        QuoteArg(instDir & "\LICENSE") & " " & _
        QuoteArg(instDir & "\assets\physlaunch.ico") & " " & _
        QuoteArg(instDir & "\assets\physlaunch.png") & " & rd " & _
        QuoteArg(instDir & "\assets") & " & rd " & _
        QuoteArg(instDir) & Chr(34)
    On Error Resume Next
    sh.Run cmd, 0, False
End Sub

Sub RenderWelcome
    verLbl.innerText = "v" & APP_VERSION
    dirBox.value = instDir
    SyncOpts

    If isUpdate Then
        welcomeTitle.innerText = "Update Physlaunch"
        btnInstall.innerText = "Update"
        btnGoUninstall.style.display = "block"
    End If

    If RegGet("HKCU\Software\Valve\Steam\SteamPath") = "" Then
        noteBox.className = "warn"
        noteBox.innerHTML = "Steam wasn't detected on this PC. Physlaunch needs Steam to find and launch your games, so install it before you use Physlaunch."
    End If
End Sub

Function OptClass(isOn)
    If isOn Then
        OptClass = "opt sel"
    Else
        OptClass = "opt"
    End If
End Function

Sub SyncOpts
    optDesktop.className = OptClass(onDesktop)
    optRunner.className = OptClass(onRunner)
    optAssoc.className = OptClass(onAssoc)
End Sub

Sub ToggleOpt(which)
    Select Case which
        Case 1: onDesktop = Not onDesktop
        Case 2: onRunner = Not onRunner
        Case 3: onAssoc = Not onAssoc
    End Select
    SyncOpts
End Sub

Sub BrowseDir()
    Dim app, folder, p
    On Error Resume Next
    Set app = CreateObject("Shell.Application")
    Set folder = app.BrowseForFolder(0, "Choose where to install Physlaunch.", 64)
    If Err.Number <> 0 Then
        Err.Clear
        Exit Sub
    End If
    If Not IsObject(folder) Then Exit Sub
    If folder Is Nothing Then Exit Sub

    p = folder.Self.Path
    If p = "" Then Exit Sub
    If Right(p, 1) = "\" Then p = Left(p, Len(p) - 1)
    ' always use a dedicated subfolder so uninstalling can never touch other files
    If LCase(Right(p, 10)) <> "\physlaunch" Then p = p & "\Physlaunch"
    dirBox.value = p
End Sub

Sub ShowView(name, dotStep)
    viewWelcome.style.display = "none"
    viewConfirm.style.display = "none"
    viewProgress.style.display = "none"
    viewDone.style.display = "none"
    document.getElementById(name).style.display = "block"

    dot1.className = "dot"
    dot2.className = "dot"
    dot3.className = "dot"
    If dotStep = 1 Then dot1.className = "dot on"
    If dotStep = 2 Then
        dot1.className = "dot done"
        dot2.className = "dot on"
    End If
    If dotStep = 3 Then
        dot1.className = "dot done"
        dot2.className = "dot done"
        dot3.className = "dot done"
    End If
End Sub

Sub ShowConfirm
    ShowView "viewConfirm", 1
End Sub

Sub BackToStart
    ShowView "viewWelcome", 1
End Sub


' ---------- install ----------

Function ValidDir(p)
    Dim re
    ValidDir = False
    Set re = New RegExp
    re.Pattern = "^[A-Za-z]:\\[^<>:""/|?*%&^!()]+$"
    If Not re.Test(p) Then Exit Function
    If Not fso.DriveExists(Left(p, 1)) Then Exit Function
    ValidDir = True
End Function

Sub StartInstall
    Dim p, list

    p = Trim(dirBox.value)
    If Right(p, 1) = "\" Then p = Left(p, Len(p) - 1)

    If Not ValidDir(p) Then
        noteBox.className = "err"
        noteBox.innerHTML = "That install location isn't valid. Pick a folder on one of your drives, for example C:\Users\you\AppData\Local\Programs\Physlaunch."
        Exit Sub
    End If
    appSrcDir = ""
    iconSource = FindPayloadAsset(srcDir, "physlaunch.ico")
    logoSource = FindPayloadAsset(srcDir, "physlaunch.png")
    If fso.FileExists(srcDir & "\app\Physlaunch.hta") And fso.FileExists(srcDir & "\app\PhyslaunchRunner.vbs") Then
        appSrcDir = srcDir & "\app"
    ElseIf fso.FileExists(srcDir & "\Physlaunch.hta") And fso.FileExists(srcDir & "\PhyslaunchRunner.vbs") Then
        appSrcDir = srcDir
    End If
    If appSrcDir = "" Or iconSource = "" Or logoSource = "" Then
        noteBox.className = "err"
        noteBox.innerHTML = "Setup can't find the Physlaunch app files and artwork. Run Setup from the full release package."
        Exit Sub
    End If
    If LCase(p) = LCase(srcDir) And Not isUpdate Then
        noteBox.className = "err"
        noteBox.innerHTML = "Choose a separate install folder so setup files in the extracted release are preserved."
        Exit Sub
    End If

    instDir = p
    mode = "install"
    progTitle.innerText = "Installing Physlaunch"

    list = "files,shortcuts"
    If onRunner Then list = list & ",runner"
    If onAssoc Then list = list & ",assoc"
    If Not onAssoc Then list = list & ",assocoff"
    list = list & ",register"
    BeginSteps list
End Sub

Sub StartUninstall
    mode = "uninstall"
    progTitle.innerText = "Removing Physlaunch"
    BeginSteps "ustop,ushortcuts,uassoc,ureg,ufiles"
End Sub

Function StepLabel(key)
    Select Case key
        Case "files": StepLabel = "Copying program files"
        Case "shortcuts": StepLabel = "Creating shortcuts"
        Case "runner": StepLabel = "Starting the Runner"
        Case "assoc": StepLabel = "Adding the .phys icon"
        Case "assocoff": StepLabel = "Removing the .phys file type"
        Case "register": StepLabel = "Registering with Windows"
        Case "ustop": StepLabel = "Stopping the Runner"
        Case "ushortcuts": StepLabel = "Removing shortcuts"
        Case "uassoc": StepLabel = "Removing the .phys file type"
        Case "ureg": StepLabel = "Cleaning up settings"
        Case "ufiles": StepLabel = "Removing program files"
    End Select
End Function

Sub BeginSteps(list)
    Dim i
    stepKeys = Split(list, ",")
    ReDim stepState(UBound(stepKeys))
    For i = 0 To UBound(stepKeys)
        stepState(i) = ""
    Next
    stepIdx = 0
    ShowView "viewProgress", 2
    RenderSteps
    window.setTimeout "runVB('RunNext')", 250, "JScript"
End Sub

Sub RenderSteps
    Dim i, html, mark
    For i = 0 To UBound(stepKeys)
        mark = ""
        If stepState(i) = "ok" Then mark = "&#10003;"
        If stepState(i) = "fail" Then mark = "!"
        html = html & "<div class='st " & stepState(i) & "'><span class='sd'>" & mark & "</span>" & StepLabel(stepKeys(i)) & "</div>"
    Next
    stepList.innerHTML = html
End Sub

Sub RunNext
    If stepIdx > UBound(stepKeys) Then
        FinishOk
        Exit Sub
    End If
    stepState(stepIdx) = "run"
    RenderSteps
    window.setTimeout "runVB('DoStep')", 200, "JScript"
End Sub

Sub DoStep
    Dim msg

    Select Case stepKeys(stepIdx)
        Case "files": msg = StepFiles()
        Case "shortcuts": msg = StepShortcuts()
        Case "runner": msg = StepRunner()
        Case "assoc": msg = StepAssoc()
        Case "assocoff": msg = StepAssocOff()
        Case "register": msg = StepRegister()
        Case "ustop": msg = StepUStop()
        Case "ushortcuts": msg = StepUShortcuts()
        Case "uassoc": msg = StepUAssoc()
        Case "ureg": msg = StepUReg()
        Case "ufiles": msg = StepUFiles()
    End Select

    If msg <> "" Then
        stepState(stepIdx) = "fail"
        RenderSteps
        FinishFail msg
        Exit Sub
    End If

    stepState(stepIdx) = "ok"
    RenderSteps
    stepIdx = stepIdx + 1
    window.setTimeout "runVB('RunNext')", 150, "JScript"
End Sub

Function StepFiles()
    Dim f, src, dst

    StepFiles = ""
    StopRunner

    On Error Resume Next
    MakeFolder instDir & "\app\assets"
    MakeFolder instDir & "\assets"
    For Each f In Array("Physlaunch.hta", "PhyslaunchRunner.vbs")
        src = appSrcDir & "\" & f
        dst = instDir & "\app\" & f
        If LCase(src) <> LCase(dst) Then fso.CopyFile src, dst, True
        If Err.Number <> 0 Then
            StepFiles = "Couldn't copy " & f & " (" & Err.Description & "). Close Physlaunch if it is open and try again."
            Exit Function
        End If
    Next

    If LCase(iconSource) <> LCase(instDir & "\assets\physlaunch.ico") Then
        fso.CopyFile iconSource, instDir & "\assets\physlaunch.ico", True
    End If
    If Err.Number = 0 And LCase(iconSource) <> LCase(instDir & "\app\assets\physlaunch.ico") Then
        fso.CopyFile iconSource, instDir & "\app\assets\physlaunch.ico", True
    End If
    If Err.Number <> 0 Then
        StepFiles = "Couldn't install the Physlaunch icon (" & Err.Description & ")."
        Exit Function
    End If

    If LCase(logoSource) <> LCase(instDir & "\assets\physlaunch.png") Then
        fso.CopyFile logoSource, instDir & "\assets\physlaunch.png", True
    End If
    If Err.Number = 0 And LCase(logoSource) <> LCase(instDir & "\app\assets\physlaunch.png") Then
        fso.CopyFile logoSource, instDir & "\app\assets\physlaunch.png", True
    End If
    If Err.Number <> 0 Then
        StepFiles = "Couldn't install the Physlaunch artwork (" & Err.Description & ")."
        Exit Function
    End If

    ' Remove the old flat icon left by earlier layouts now that app/assets is in place.
    DeleteFileIfThere instDir & "\app\physlaunch.ico"

    If LCase(scriptPath) <> LCase(instDir & "\Setup.hta") Then fso.CopyFile scriptPath, instDir & "\Setup.hta", True
    If fso.FileExists(srcDir & "\LICENSE") And LCase(srcDir) <> LCase(instDir) Then fso.CopyFile srcDir & "\LICENSE", instDir & "\LICENSE", True
    If Err.Number <> 0 Then
        StepFiles = "Couldn't finish copying files (" & Err.Description & ")."
        Exit Function
    End If
End Function

Function StepShortcuts()
    Dim hta, ico, menu

    StepShortcuts = ""
    hta = instDir & "\app\Physlaunch.hta"
    ico = instDir & "\app\assets\physlaunch.ico"
    menu = MenuFolder()

    On Error Resume Next
    MakeFolder menu
    MakeLink menu & "\Physlaunch.lnk", hta, "", ico, "Turn any drive into a game launcher"
    MakeLink menu & "\Uninstall Physlaunch.lnk", SysPath("mshta.exe"), """" & instDir & "\Setup.hta"" /uninstall", ico, "Remove Physlaunch"
    If onDesktop Then
        MakeLink DesktopLink(), hta, "", ico, "Turn any drive into a game launcher"
    Else
        DeleteFileIfThere DesktopLink()
    End If
    If Not onRunner Then DeleteFileIfThere StartupLink()

    If Err.Number <> 0 Then StepShortcuts = "Couldn't create shortcuts (" & Err.Description & ")."
End Function

Function StepRunner()
    Dim runner, wscr

    StepRunner = ""
    runner = instDir & "\app\PhyslaunchRunner.vbs"
    wscr = SysPath("wscript.exe")

    On Error Resume Next
    Err.Clear
    MakeLink StartupLink(), wscr, """" & runner & """", instDir & "\app\assets\physlaunch.ico", "Physlaunch Runner"
    If Err.Number <> 0 Then
        StepRunner = "Couldn't set the Runner to start with Windows (" & Err.Description & ")."
        Exit Function
    End If
    If Not fso.FileExists(StartupLink()) Then
        StepRunner = "The Runner shortcut wasn't created in your Windows Startup folder."
        Exit Function
    End If

    Err.Clear
    sh.Run """" & wscr & """ """ & runner & """", 0, False
    If Err.Number <> 0 Then
        StepRunner = "Windows couldn't start the Runner (" & Err.Description & ")."
        Exit Function
    End If
    sh.RegWrite REG_ROOT & "\RunnerPrompted", "1", "REG_SZ"
    If Err.Number <> 0 Then
        StepRunner = "The Runner started, but Setup couldn't save its startup setting (" & Err.Description & ")."
        Exit Function
    End If
End Function

Function StepAssoc()
    Dim classes, ico, runner

    StepAssoc = ""
    classes = "HKCU\Software\Classes\"
    ico = instDir & "\app\assets\physlaunch.ico"
    runner = instDir & "\app\PhyslaunchRunner.vbs"

    On Error Resume Next
    sh.RegWrite classes & ".phys\", PROGID, "REG_SZ"
    sh.RegWrite classes & PROGID & "\", "Physlaunch Game Marker", "REG_SZ"
    sh.RegWrite classes & PROGID & "\DefaultIcon\", ico, "REG_SZ"
    sh.RegWrite classes & PROGID & "\shell\open\", "&Launch game", "REG_SZ"
    sh.RegWrite classes & PROGID & "\shell\open\command\", """" & SysPath("wscript.exe") & """ """ & runner & """ /open ""%1""", "REG_SZ"
    If Err.Number <> 0 Then
        StepAssoc = "Couldn't register the .phys file type (" & Err.Description & ")."
        Exit Function
    End If
    RefreshIcons
End Function

Function StepAssocOff()
    StepAssocOff = ""
    RemoveAssociation
    RefreshIcons
End Function

Function StepRegister()
    Dim base, today

    StepRegister = ""
    base = UNINSTALL_KEY & "\"
    today = Year(Date) & Right("0" & Month(Date), 2) & Right("0" & Day(Date), 2)

    On Error Resume Next
    sh.RegWrite REG_ROOT & "\InstallDir", instDir, "REG_SZ"
    sh.RegWrite REG_ROOT & "\Version", APP_VERSION, "REG_SZ"
    sh.RegWrite base & "DisplayName", "Physlaunch", "REG_SZ"
    sh.RegWrite base & "DisplayVersion", APP_VERSION, "REG_SZ"
    sh.RegWrite base & "DisplayIcon", instDir & "\app\assets\physlaunch.ico", "REG_SZ"
    sh.RegWrite base & "InstallLocation", instDir, "REG_SZ"
    sh.RegWrite base & "InstallDate", today, "REG_SZ"
    sh.RegWrite base & "UninstallString", """" & SysPath("mshta.exe") & """ """ & instDir & "\Setup.hta"" /uninstall", "REG_SZ"
    sh.RegWrite base & "NoModify", 1, "REG_DWORD"
    sh.RegWrite base & "NoRepair", 1, "REG_DWORD"
    If Err.Number <> 0 Then StepRegister = "Couldn't register Physlaunch with Windows (" & Err.Description & ")."
End Function


' ---------- uninstall ----------

Function StepUStop()
    StepUStop = ""
    StopRunner
    DeleteFileIfThere StartupLink()
End Function

Function StepUShortcuts()
    StepUShortcuts = ""
    On Error Resume Next
    If fso.FolderExists(MenuFolder()) Then fso.DeleteFolder MenuFolder(), True
    DeleteFileIfThere DesktopLink()
    Err.Clear
End Function

Function StepUAssoc()
    StepUAssoc = ""
    RemoveAssociation
    RefreshIcons
End Function

Function StepUReg()
    StepUReg = ""
    RegDeleteTree UNINSTALL_KEY
    RegDeleteTree "HKCU\Software\Physlaunch"
    On Error Resume Next
    ' the Runner's log lives here
    If fso.FolderExists(sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Physlaunch") Then fso.DeleteFolder sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Physlaunch", True
    Err.Clear
End Function

Function StepUFiles()
    StepUFiles = ""
    deletePending = True
End Function


' ---------- finish ----------

Sub FinishOk
    ShowView "viewDone", 3
    btnBack.style.display = "none"

    If mode = "install" Then
        doneTitle.innerText = "Physlaunch is installed"
        btnOpen.style.display = "block"
        doneMsg.className = "ok"
        doneMsg.innerHTML = "Everything is set up. Open Physlaunch, pick a game and a USB drive, and write the launcher file."
        If onRunner Then doneMsg.innerHTML = doneMsg.innerHTML & "<br><br>The Runner was started and added to Windows sign-in, so plugging in a prepared drive should launch its game."
        If RegGet("HKCU\Software\Valve\Steam\SteamPath") = "" Then doneMsg.innerHTML = doneMsg.innerHTML & "<br><br>Remember to install Steam, because Physlaunch needs it."
    Else
        doneTitle.innerText = "Physlaunch has been removed"
        btnOpen.style.display = "none"
        doneMsg.className = "ok"
        doneMsg.innerHTML = "Physlaunch is gone from this PC. You can close this window."
    End If
End Sub

Sub FinishFail(msg)
    ShowView "viewDone", 2
    doneTitle.innerText = "Something went wrong"
    btnOpen.style.display = "none"
    btnBack.style.display = "block"
    doneMsg.className = "err"
    doneMsg.innerHTML = HtmlEncode(msg)
    deletePending = False
End Sub

Sub OpenApp
    On Error Resume Next
    sh.Run """" & instDir & "\app\Physlaunch.hta""", 1, False
    window.close
End Sub
</script>
</body>
</html>
